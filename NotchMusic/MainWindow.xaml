<Window x:Class="NotchMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotchMusic"
        Title="NotchMusic" Width="128" Height="34" Cursor="Arrow"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI" Foreground="White"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        PreviewMouseLeftButtonDown="Window_DragPressed" PreviewMouseMove="Window_DragMoved"
        PreviewMouseLeftButtonUp="Window_DragReleased" LostMouseCapture="Window_DragCaptureLost"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Empat warna dari palet pilihanmu. Warna teks ditambah agar terbaca. -->
        <SolidColorBrush x:Key="NotchBackground" Color="#6A795D" />
        <SolidColorBrush x:Key="NotchSurface" Color="#8E9162" />
        <SolidColorBrush x:Key="NotchSoft" Color="#B2BD7E" />
        <SolidColorBrush x:Key="NotchAccent" Color="#D9D28B" />
        <SolidColorBrush x:Key="NotchInk" Color="#182116" />

        <!-- Logo N mint dari svg/NotchMusic_Logo_Mint.svg: bentuk N dikurangi dua celah diagonal. -->
        <CombinedGeometry x:Key="NotchLogoGeometry" GeometryCombineMode="Exclude"
                          Geometry1="M0 8 L8 0 H25 L75 59 V8 L83 0 H100 V92 L92 100 H75 L25 41 V92 L17 100 H0 Z">
            <CombinedGeometry.Geometry2>
                <GeometryGroup>
                    <GeometryGroup>
                        <GeometryGroup.Transform><TransformGroup>
                            <RotateTransform Angle="-42" CenterX="28.5" CenterY="3.25" /><TranslateTransform Y="21" />
                        </TransformGroup></GeometryGroup.Transform>
                        <RectangleGeometry Rect="0,0,57,6.5" />
                        <PathGeometry Figures="M19.38 4.55 H37.62 V12.948 A5.8368 3.952 0 0 1 31.7832 16.9 H25.2168 A5.8368 3.952 0 0 1 19.38 12.948 Z" />
                    </GeometryGroup>
                    <GeometryGroup>
                        <GeometryGroup.Transform><TransformGroup>
                            <RotateTransform Angle="-42" CenterX="28.5" CenterY="3.25" /><TranslateTransform X="43" Y="72.5" />
                        </TransformGroup></GeometryGroup.Transform>
                        <RectangleGeometry Rect="0,0,57,6.5" />
                        <PathGeometry Figures="M19.38 1.95 V-6.448 A5.8368 3.952 0 0 1 25.2168 -10.4 H31.7832 A5.8368 3.952 0 0 1 37.62 -6.448 V1.95 Z" />
                    </GeometryGroup>
                </GeometryGroup>
            </CombinedGeometry.Geometry2>
        </CombinedGeometry>
        <!-- Ikon memakai bidang 20 x 20, bukan karakter font yang punya ruang baseline. -->
        <!-- Segitiga play diposisikan menurut pusat visualnya agar tidak tampak ke kiri. -->
        <Geometry x:Key="PlayIconGeometry">M6,3 L18,10 L6,17 Z</Geometry>
        <Geometry x:Key="PauseIconGeometry">M5,3 H9 V17 H5 Z M11,3 H15 V17 H11 Z</Geometry>
        <Geometry x:Key="PreviousIconGeometry">M3,3 H5 V17 H3 Z M17,3 V17 L7,10 Z</Geometry>
        <Geometry x:Key="NextIconGeometry">M15,3 H17 V17 H15 Z M3,3 L13,10 L3,17 Z</Geometry>

        <!-- Tombol teks kecil (Jeda, Reset, Scan Steam): pil tanpa garis tepi, warna tema. -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource NotchSurface}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chip" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource NotchAccent}" />
                        <Setter Property="Foreground" Value="{DynamicResource NotchInk}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chip" Property="Opacity" Value="0.75" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MusicButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NotchSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource NotchInk}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="20" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource NotchAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Track WPF menangani mouse, keyboard, dan aksesibilitas. -->
        <Style x:Key="SeekBar" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="SmallChange" Value="5" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" Margin="0,2">
                            <Track x:Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5"
                                                        Background="{DynamicResource NotchAccent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="18" Cursor="Arrow">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="Knob" Width="10" Height="10"
                                                             Fill="{DynamicResource NotchAccent}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Width" Value="14" />
                                                        <Setter TargetName="Knob" Property="Height" Value="14" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5"
                                                        Background="{DynamicResource NotchSoft}" Opacity="0.5" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardScrollArrow" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Delay" Value="300" />
            <Setter Property="Interval" Value="60" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                <Border x:Name="ArrowSurface" Background="{TemplateBinding Background}" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource NotchSurface}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowSurface" Property="Opacity" Value="0.65" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ClipboardScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                <Border Background="Transparent" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ClipboardScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource NotchSoft}" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="MinHeight" Value="12" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource NotchAccent}" /><Setter Property="Opacity" Value="1" /></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{DynamicResource NotchAccent}" /><Setter Property="Opacity" Value="1" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipboardScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Margin" Value="4,2,0,2" />
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid SnapsToDevicePixels="True">
                    <Grid.RowDefinitions><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /></Grid.RowDefinitions>
                    <RepeatButton Style="{StaticResource ClipboardScrollArrow}" Command="{x:Static ScrollBar.LineUpCommand}" AutomationProperties.Name="Gulir ke atas">
                        <Path Width="8" Height="5" Stretch="Uniform" Data="M2,5 L5,2 L8,5" Stroke="{DynamicResource NotchAccent}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </RepeatButton>
                    <Border Grid.Row="1" Background="#268E9162" CornerRadius="4" Margin="2,1" />
                    <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Orientation="Vertical"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ClipboardScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}" /></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource ClipboardScrollThumb}" /></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ClipboardScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}" /></Track.IncreaseRepeatButton>
                    </Track>
                    <RepeatButton Grid.Row="2" Style="{StaticResource ClipboardScrollArrow}" Command="{x:Static ScrollBar.LineDownCommand}" AutomationProperties.Name="Gulir ke bawah">
                        <Path Width="8" Height="5" Stretch="Uniform" Data="M2,2 L5,5 L8,2" Stroke="{DynamicResource NotchAccent}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </RepeatButton>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ClipboardRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="RowBorder" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#388E9162" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#4CB2BD7E" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Dropdown untuk jendela lirik: ikut warna tema seperti tombol notch. -->
        <Style x:Key="ThemedComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource NotchInk}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="ItemContainerStyle"><Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="Foreground" Value="{DynamicResource NotchInk}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource NotchAccent}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Box" Background="{DynamicResource NotchSoft}" BorderBrush="{DynamicResource NotchSurface}"
                                    BorderThickness="1" CornerRadius="7">
                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" Data="M0,0 L4,4 L8,0"
                                      Stroke="{DynamicResource NotchInk}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource NotchAccent}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                           IsOpen="{TemplateBinding IsDropDownOpen}">
                        <Border Background="{DynamicResource NotchPopup}" BorderBrush="{DynamicResource NotchSurface}" BorderThickness="1"
                                CornerRadius="7" Padding="4" Margin="0,4,0,0" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Menu klik kanan (notch dan ikon game): kotak kecil berwarna tema. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{DynamicResource NotchBackground}" BorderBrush="{DynamicResource NotchSurface}" BorderThickness="1"
                        CornerRadius="8" Padding="4">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="6,5,12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Check" Text="✓" Width="18" FontWeight="SemiBold" Visibility="Hidden" />
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource NotchSurface}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
                <Border Height="1" Margin="6,4" Background="{DynamicResource NotchSurface}" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <!-- Batas tampilan dianimasikan tanpa mengubah ukuran HWND/layout setiap frame. -->
    <local:NotchSurface x:Name="NotchViewport" Background="Transparent" ClipToBounds="True"
                        VisibleBounds="0,0,128,34"
                        AutomationProperties.HelpText="Seret jam, judul, cover, lirik, atau bagian kosong. Tarik ke bawah untuk melepas dari atas layar; dekatkan ke atas untuk menempel kembali.">
        <local:NotchSurface.ContextMenu>
            <ContextMenu x:Name="NotchMenu"
                         Opened="NotchMenu_Opened" Closed="NotchMenu_Closed" />
        </local:NotchSurface.ContextMenu>
    <Border x:Name="Shell" Width="620" Height="160" Canvas.Left="-254" Background="Transparent"
            Cursor="Arrow" Padding="12,8" BorderThickness="1">
        <Border.RenderTransform><TranslateTransform x:Name="ShellShift" /></Border.RenderTransform>
        <Grid>
            <!-- Lirik hanya saat tersedia dan Playing; selain itu jam saja. -->
            <Grid x:Name="CompactPanel" Width="48" Height="24" Margin="0,-4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel x:Name="CompactIdle" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform" Fill="#7DE2B4" VerticalAlignment="Center"
                          Data="{StaticResource NotchLogoGeometry}" IsHitTestVisible="False" AutomationProperties.Name="Logo NotchMusic" />
                    <TextBlock x:Name="CompactClock" Text="00:00" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" AutomationProperties.Name="Jam saat ini" />
                </StackPanel>
                <!-- Notifikasi WhatsApp/browser baru, tampil sebentar menggantikan jam/lirik. -->
                <TextBlock x:Name="CompactNotice" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Notifikasi baru" />
                <Grid x:Name="CompactMusic" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                    <Grid x:Name="CompactLyricViewport" Height="24" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center">
                    <Grid x:Name="CompactOutgoing" Visibility="Collapsed" IsHitTestVisible="False">
                        <Grid.RenderTransform><TranslateTransform x:Name="CompactOutgoingShift" /></Grid.RenderTransform>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactOutgoingLyric" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="NoWrap" />
                        </Viewbox>
                    </Grid>
                    <Grid>
                        <Grid.RenderTransform><TranslateTransform x:Name="CompactIncomingShift" /></Grid.RenderTransform>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactLyric" Text="Mencari lirik…" FontSize="16" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="NoWrap" VerticalAlignment="Center"
                                   AutomationProperties.Name="Baris lirik saat ini" />
                        </Viewbox>
                    </Grid>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Height="18" IsHitTestVisible="False" AutomationProperties.Name="Musik sedang diputar">
                        <Border Width="3" Height="18" Margin="1.5,0" CornerRadius="1.5" Background="{DynamicResource NotchAccent}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="EqScale1" ScaleY="0.35" /></Border.RenderTransform>
                        </Border>
                        <Border Width="3" Height="18" Margin="1.5,0" CornerRadius="1.5" Background="{DynamicResource NotchAccent}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="EqScale2" ScaleY="0.55" /></Border.RenderTransform>
                        </Border>
                        <Border Width="3" Height="18" Margin="1.5,0" CornerRadius="1.5" Background="{DynamicResource NotchAccent}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="EqScale3" ScaleY="0.85" /></Border.RenderTransform>
                        </Border>
                        <Border Width="3" Height="18" Margin="1.5,0" CornerRadius="1.5" Background="{DynamicResource NotchAccent}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="EqScale4" ScaleY="0.45" /></Border.RenderTransform>
                        </Border>
                        <Border Width="3" Height="18" Margin="1.5,0" CornerRadius="1.5" Background="{DynamicResource NotchAccent}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="EqScale5" ScaleY="0.65" /></Border.RenderTransform>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Mode terbuka lebih pipih: cover sejajar dengan tanggal/jam dan judul. -->
            <!-- Skala seragam: seluruh isi ikut tumbuh dan tombol tetap bulat selama morph. -->
            <Viewbox x:Name="ExpandedHost" Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Width="594" Height="142"
                     RenderTransformOrigin="0.5,0"
                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
            <Viewbox.RenderTransform><ScaleTransform x:Name="ExpandedScale" ScaleX="0.94" ScaleY="0.94" /></Viewbox.RenderTransform>
            <Grid x:Name="ExpandedDeck" Width="594" Height="142">
                <!-- Panah tetap di sisi luar; hanya isi tengah yang bergeser antarhalaman. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="522" />
                    <ColumnDefinition Width="8" /><ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="PageViewport" Grid.Column="2" Width="522" ClipToBounds="True">
                <Grid x:Name="MusicPage">
                    <Grid.RenderTransform><TranslateTransform x:Name="MusicPageShift" /></Grid.RenderTransform>
            <Grid x:Name="ExpandedPanel" Width="522" Height="142">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292" /><ColumnDefinition Width="18" /><ColumnDefinition Width="212" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PlayerPanel">
                <Grid Height="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" Background="{DynamicResource NotchSurface}" CornerRadius="10"
                            VerticalAlignment="Center">
                        <Grid>
                            <Viewbox x:Name="CoverFallback" Width="24" Height="24" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Data="M8,15 V5 L17,3 V13 M8,8 L17,6"
                                          Stroke="{DynamicResource NotchAccent}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Canvas.Left="3" Canvas.Top="13" Width="5" Height="4" Fill="{DynamicResource NotchAccent}" />
                                    <Ellipse Canvas.Left="12" Canvas.Top="11" Width="5" Height="4" Fill="{DynamicResource NotchAccent}" />
                                </Canvas>
                            </Viewbox>
                            <Image x:Name="CoverImage" Width="48" Height="48" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,48,48" RadiusX="10" RadiusY="10" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClockFull" Text="00:00" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="FullDate" Grid.Column="1" Text="Senin, 19 Oktober 2026"
                                       FontSize="10" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock x:Name="SongTitle" Text="Belum ada musik" FontSize="14" Margin="0,2,0,0"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistName" Text="Putar lagu di pemutar favoritmu"
                                   FontSize="11" Foreground="White" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="SourceButton" Grid.Column="2" Style="{StaticResource MusicButton}"
                            Width="24" Height="24" Margin="0" HorizontalAlignment="Right"
                            ToolTip="Pilih sumber musik"
                            AutomationProperties.Name="Pilih sumber musik" Click="SourceButton_Click">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Path Data="M3,3.5 H17 V13 H3 Z M10,13 V16.5 M6.5,16.5 H13.5"
                                      Stroke="{DynamicResource NotchInk}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- Waktu dan slider satu baris; kontrol tetap berada di bawah progres. -->
                <Grid Margin="0,6,0,0" Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText" Text="--:--" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource SeekBar}" Margin="8,0"
                            Minimum="0" Maximum="1" Value="0" IsEnabled="False" IsMoveToPointEnabled="True"
                            ToolTip="Waktu belum tersedia dari pemutar" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Posisi lagu dalam detik"
                            ValueChanged="SeekSlider_ValueChanged"
                            Thumb.DragStarted="SeekSlider_DragStarted" Thumb.DragCompleted="SeekSlider_DragCompleted" />
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="--:--" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,4,0,0" Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Style="{StaticResource MusicButton}" Width="22" Height="22" Margin="0,0,3,0"
                                ToolTip="Selalu di atas: aktif" AutomationProperties.Name="Nonaktifkan selalu di atas" Click="PinButton_Click">
                            <Viewbox Width="14" Height="14" IsHitTestVisible="False"><Canvas Width="20" Height="20">
                                <Path Data="M6,3 H14 M7,3 V9 L4.5,12 H15.5 L13,9 V3 M10,12 V18"
                                      Stroke="{DynamicResource NotchInk}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path x:Name="PinSlash" Data="M3,3 L17,17" Visibility="Collapsed"
                                      Stroke="{DynamicResource NotchInk}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas></Viewbox>
                        </Button>
                        <Button x:Name="ThemeButton" Style="{StaticResource MusicButton}" Width="22" Height="22" Margin="0,0,3,0"
                                ToolTip="Ganti tema" AutomationProperties.Name="Ganti tema warna" Click="ThemeButton_Click"
                                MouseRightButtonUp="ThemeButton_RightClick">
                            <Viewbox Width="14" Height="14" IsHitTestVisible="False"><Canvas Width="20" Height="20">
                                <Ellipse Width="16" Height="16" Canvas.Left="2" Canvas.Top="2" Stroke="{DynamicResource NotchInk}" StrokeThickness="1.6" />
                                <Path Data="M10,2 A8,8 0 0 1 10,18 Z" Fill="{DynamicResource NotchInk}" />
                            </Canvas></Viewbox>
                        </Button>
                        <Button x:Name="MinimizeButton" Style="{StaticResource MusicButton}" Width="22" Height="22" Margin="0"
                                ToolTip="Minimalkan ke tray — musik tetap berjalan" AutomationProperties.Name="Minimalkan ke tray" Click="MinimizeButton_Click">
                            <Viewbox Width="14" Height="14" IsHitTestVisible="False"><Canvas Width="20" Height="20">
                                <Path Data="M4,10 H16" Stroke="{DynamicResource NotchInk}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas></Viewbox>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PreviousButton" Style="{StaticResource MusicButton}"
                                ToolTip="Sebelumnya" IsEnabled="False"
                                AutomationProperties.Name="Lagu sebelumnya" Click="Previous_Click">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Data="{StaticResource PreviousIconGeometry}" Fill="{DynamicResource NotchInk}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Grid Width="44" Height="44">
                            <Ellipse Width="42" Height="42" Stroke="{DynamicResource NotchSoft}" StrokeThickness="2" Opacity="0.45" />
                            <Path x:Name="ProgressPath" Stroke="{DynamicResource NotchAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Visibility="Collapsed">
                                <Path.Data><PathGeometry><PathFigure x:Name="ProgressFigure" StartPoint="22,2" IsClosed="False" IsFilled="False">
                                    <ArcSegment x:Name="ProgressArc" Point="22,2" Size="20,20"
                                                SweepDirection="Clockwise" IsLargeArc="False" />
                                </PathFigure></PathGeometry></Path.Data>
                            </Path>
                            <Ellipse x:Name="FullProgress" Width="42" Height="42" Stroke="{DynamicResource NotchAccent}"
                                     StrokeThickness="2" IsHitTestVisible="False" Visibility="Collapsed" />
                            <Button x:Name="PlayPauseButton" Style="{StaticResource MusicButton}"
                                    Width="34" Height="34" Margin="0" HorizontalAlignment="Center"
                                    Background="{DynamicResource NotchAccent}"
                                    ToolTip="Putar / jeda" IsEnabled="False"
                                    AutomationProperties.Name="Putar atau jeda" Click="PlayPause_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="ControlsMenu_Opened" Closed="ControlsMenu_Closed"><MenuItem x:Name="StopMenuItem" Header="Hentikan pemutaran"
                                                           IsEnabled="False" Click="Stop_Click" /></ContextMenu>
                                </Button.ContextMenu>
                                <Viewbox Width="18" Height="18" Stretch="Uniform" IsHitTestVisible="False">
                                    <Canvas Width="20" Height="20">
                                        <Path x:Name="PlayPauseIcon" Data="{StaticResource PlayIconGeometry}" Fill="{DynamicResource NotchInk}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                        <Button x:Name="NextButton" Style="{StaticResource MusicButton}"
                                ToolTip="Berikutnya" IsEnabled="False"
                                AutomationProperties.Name="Lagu berikutnya" Click="Next_Click">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Path Data="{StaticResource NextIconGeometry}" Fill="{DynamicResource NotchInk}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                    <Button x:Name="LyricsButton" Grid.Column="2" Style="{StaticResource MusicButton}"
                            Width="24" Height="24" Margin="0" HorizontalAlignment="Right"
                            IsEnabled="False" ToolTip="Buka lirik" AutomationProperties.Name="Buka lirik"
                            Click="LyricsButton_Click">
                        <Viewbox Width="16" Height="16" Stretch="Uniform" IsHitTestVisible="False">
                            <Canvas Width="20" Height="20">
                                <Path Data="M2,15.5 L6,4.5 L10,15.5 M3.5,11.5 H8.5 M17.5,11.5 C17.5,7.5 12,7.5 12,11.5 C12,15.5 17.5,15.5 17.5,11.5 M17.5,8.5 V15.5"
                                      Stroke="{DynamicResource NotchInk}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
                <TextBlock x:Name="StatusText" Text="" FontSize="9" Height="12" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="110" VerticalAlignment="Center"
                        Background="{DynamicResource NotchSoft}" Opacity="0.35" />
                <Grid Grid.Column="2" ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="16" /><RowDefinition Height="*" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                    <TextBlock x:Name="InlineLyricsHint" Text="Lirik" Visibility="Collapsed" FontSize="10" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                    <Grid x:Name="LyricLines" Grid.Row="1" ClipToBounds="True">
                        <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="*" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviousLyric" FontSize="11" Opacity="0.45"
                                       TextAlignment="Center" TextWrapping="NoWrap" />
                        </Viewbox>
                        <Border Grid.Row="1" Margin="0,2" Padding="4,2" CornerRadius="7" Background="#268E9162">
                            <Grid x:Name="ExpandedLyricViewport" ClipToBounds="True">
                            <Grid x:Name="ExpandedOutgoing" Visibility="Collapsed" IsHitTestVisible="False">
                                <Grid.RenderTransform><TranslateTransform x:Name="ExpandedOutgoingShift" /></Grid.RenderTransform>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                                <TextBlock x:Name="ExpandedOutgoingLyric" Width="204" FontSize="14" LineHeight="18"
                                           FontWeight="SemiBold" Foreground="{DynamicResource NotchAccent}" TextWrapping="Wrap" TextAlignment="Center" />
                                </Viewbox>
                            </Grid>
                            <Grid>
                                <Grid.RenderTransform><TranslateTransform x:Name="ExpandedIncomingShift" /></Grid.RenderTransform>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentLyric" Width="204" Text="Belum ada lagu" FontSize="14" LineHeight="18"
                                           FontWeight="SemiBold" Foreground="{DynamicResource NotchAccent}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                </Viewbox>
                            </Grid>
                            </Grid>
                        </Border>
                        <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                            <TextBlock x:Name="NextLyric" FontSize="11" Opacity="0.45"
                                       TextAlignment="Center" TextWrapping="NoWrap" />
                        </Viewbox>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Aa · pilih lirik" FontSize="9" Opacity="0.65" TextAlignment="Center" />
                </Grid>
            </Grid>
                </Grid>
                <Grid x:Name="ClipboardPage" Margin="0,0,0,8" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.RenderTransform><TranslateTransform x:Name="ClipboardPageShift" X="522" /></Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" /><RowDefinition Height="28" />
                        <RowDefinition Height="*" /><RowDefinition Height="16" />
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Center" Height="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Riwayat" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ClipboardCount" Text="0 / 64" FontSize="10" Opacity="0.75" Margin="8,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="ClipboardPauseButton" Grid.Column="1" Style="{StaticResource ChipButton}" MinWidth="48" Margin="0,0,4,0"
                                Content="Jeda" ToolTip="Jeda pencatatan clipboard" Click="ClipboardPause_Click" />
                        <Button x:Name="ClipboardClearButton" Grid.Column="2" Style="{StaticResource ChipButton}" MinWidth="48" HorizontalAlignment="Right"
                                Content="Reset" ToolTip="Hapus seluruh riwayat clipboard notch" Click="ClipboardClear_Click" />
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource NotchSoft}" CornerRadius="7" Padding="9,2" Margin="0,2,0,4">
                        <Grid>
                            <TextBox x:Name="ClipboardSearchBox" FontSize="12" VerticalContentAlignment="Center"
                                     Background="Transparent" Foreground="{DynamicResource NotchInk}" BorderThickness="0" Padding="0"
                                     MaxLength="256" TextChanged="ClipboardSearch_TextChanged"
                                     AutomationProperties.Name="Cari kata dalam riwayat clipboard" />
                            <TextBlock Text="Cari kata dalam clipboard…" FontSize="12" Foreground="#7F182116"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ClipboardSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ClipboardList" Background="Transparent" BorderThickness="0" Padding="0"
                                 Foreground="White" ItemContainerStyle="{StaticResource ClipboardRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="Riwayat teks clipboard">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ClipboardScrollBar}" />
                            </ListBox.Resources>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="28" /><ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Preview}" ToolTip="{Binding Tooltip}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontSize="9" Opacity="0.65" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{StaticResource MusicButton}" Width="22" Height="22" Margin="0"
                                            Tag="{Binding}" ToolTip="Salin kembali, lalu gunakan Ctrl+V" AutomationProperties.Name="Salin teks ini" Click="ClipboardCopy_Click">
                                        <Viewbox Width="13" Height="13" IsHitTestVisible="False"><Canvas Width="20" Height="20">
                                            <Path Data="M7,3 H16 V13 H7 Z M4,7 H3 V17 H12 V16" Stroke="{DynamicResource NotchInk}"
                                                  StrokeThickness="1.5" StrokeLineJoin="Round" />
                                        </Canvas></Viewbox>
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource MusicButton}" Width="18" Height="18" Margin="0"
                                            Tag="{Binding}" ToolTip="Hapus salinan ini" AutomationProperties.Name="Hapus salinan ini" Click="ClipboardDelete_Click">
                                        <Viewbox Width="11" Height="11" IsHitTestVisible="False"><Canvas Width="20" Height="20">
                                            <Path Data="M5,5 L15,15 M15,5 L5,15" Stroke="{DynamicResource NotchInk}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas></Viewbox>
                                    </Button>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ClipboardEmpty" Text="Salin teks dengan Ctrl+C untuk memulai." FontSize="11" Opacity="0.7"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock x:Name="ClipboardStatus" Grid.Row="3" Text="Riwayat sesi · teks saja" FontSize="10" Opacity="0.8"
                               Margin="12,0" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                <!-- Halaman game: game Steam terakhir dimainkan, klik untuk membuka. -->
                <Grid x:Name="GamePage" Margin="0,0,0,8" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.RenderTransform><TranslateTransform x:Name="GamePageShift" X="522" /></Grid.RenderTransform>
                    <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Game" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Right" Content="Scan Steam" ToolTip="Tambahkan game Steam yang terakhir dimainkan" Click="SteamScan_Click" />
                    </Grid>
                    <ItemsControl x:Name="GameList" Grid.Row="1" Margin="0,2,0,0" AutomationProperties.Name="Daftar game">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8" Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Tag="{Binding}" Click="Game_Click" ContextMenuOpening="Game_MenuOpening" Margin="3" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="Game_DragStart" PreviewMouseMove="Game_DragMove"
                                    AllowDrop="True" DragOver="Game_DragOver" DragLeave="Game_DragLeave" Drop="Game_Drop"
                                    Focusable="False" Foreground="White" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="GameMenu_Opened" Closed="GameMenu_Closed">
                                        <MenuItem Header="Hapus dari daftar" Click="GameRemove_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Template><ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                    <!-- Garis tempat taruh saat ikon diseret (kiri = sebelum, kanan = sesudah ikon ini). -->
                                    <Border x:Name="DropLeft" Width="3" Height="40" CornerRadius="1.5" HorizontalAlignment="Left"
                                            Background="{DynamicResource NotchAccent}" Visibility="Collapsed" IsHitTestVisible="False" />
                                    <Border x:Name="DropRight" Width="3" Height="40" CornerRadius="1.5" HorizontalAlignment="Right"
                                            Background="{DynamicResource NotchAccent}" Visibility="Collapsed" IsHitTestVisible="False" />
                                    <!-- Ikon kotak seperti shortcut Desktop; nama cukup di tooltip. -->
                                    <Border x:Name="Card" CornerRadius="10" Padding="6" Background="Transparent"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="44" Height="44">
                                            <Border x:Name="Fallback" CornerRadius="10" Background="{DynamicResource NotchSurface}" Visibility="Collapsed">
                                                <TextBlock Text="{Binding Name[0]}" FontSize="20" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Grid x:Name="AddMark" Visibility="Collapsed">
                                                <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource NotchSoft}" StrokeThickness="1.5"
                                                           StrokeDashArray="3 2" Opacity="0.8" />
                                                <Path Data="M22,13 V31 M13,22 H31" Stroke="{DynamicResource NotchSoft}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Grid>
                                            <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="Fallback" Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsAdd}" Value="True">
                                            <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="AddMark" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#26FFFFFF" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.75" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Button.Template>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="GameStatus" Grid.Row="2" Text="Klik buka · seret untuk pindah · + tambah · klik kanan hapus" FontSize="10" Opacity="0.8"
                               TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                </Grid>
                <!-- Jarak dari tepi: padding Shell 12,8 + margin ini, aman dari lengkungan sudut. -->
                <Path Grid.Column="0" Width="16" Height="16" Margin="0,6,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Stretch="Uniform" Fill="#7DE2B4" Data="{StaticResource NotchLogoGeometry}"
                      IsHitTestVisible="False" AutomationProperties.Name="Logo NotchMusic" />
                <Button x:Name="PreviousPageButton" Grid.Column="0" Style="{StaticResource MusicButton}"
                        Width="24" Height="24" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip="Halaman sebelumnya · berulang" Focusable="False"
                        AutomationProperties.Name="Halaman sebelumnya" Click="PreviousPage_Click">
                    <Viewbox Width="12" Height="12" IsHitTestVisible="False"><Canvas Width="20" Height="20">
                        <Path Data="M13,4 L7,10 L13,16" Stroke="{DynamicResource NotchInk}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas></Viewbox>
                </Button>
                <Button x:Name="NextPageButton" Grid.Column="4" Style="{StaticResource MusicButton}"
                        Width="24" Height="24" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip="Halaman berikutnya · berulang" Focusable="False"
                        AutomationProperties.Name="Halaman berikutnya" Click="NextPage_Click">
                    <Viewbox Width="12" Height="12" IsHitTestVisible="False"><Canvas Width="20" Height="20">
                        <Path Data="M7,4 L13,10 L7,16" Stroke="{DynamicResource NotchInk}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas></Viewbox>
                </Button>
            </Grid>
            </Viewbox>
        </Grid>
    </Border>
    </local:NotchSurface>
</Window>
